@inherits LayoutComponentBase

<header class="top">
    <a class="brand" href="">📬 SpamSharp</a>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All">Übersicht</NavLink>
        <AuthorizeView Roles="admin">
            <NavLink href="rules">Regeln</NavLink>
            <NavLink href="settings">Einstellungen</NavLink>
        </AuthorizeView>
    </nav>
    <form method="post" action="logout" class="logout">
        <span class="muted"><AuthorizeView>@context.User.Identity?.Name</AuthorizeView></span>
        <button class="link">Abmelden</button>
    </form>
</header>

<main>@Body</main>

<div id="blazor-error-ui" data-nosnippet>
    Ein Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>
