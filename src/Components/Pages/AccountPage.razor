@page "/account/{Id:long?}"
@inject Scanner Scanner
@inject NavigationManager Nav

<PageTitle>Postfach – SpamSharp</PageTitle>

<h2>@(Id is null ? "Neues Postfach" : "Postfach bearbeiten")</h2>

<EditForm Model="acc" OnSubmit="Save" class="form">
    <label>
        Anbieter
        <select @bind="provider" @bind:after="ApplyProvider">
            <option value="">– bitte wählen –</option>
            @foreach (var p in Providers.All)
            {
                <option value="@p.Name">@p.Name</option>
            }
            <option value="@Other">Anderer Anbieter</option>
        </select>
    </label>
    @if (Preset?.Hint is { } hint)
    {
        <p class="note @(Preset.Host is null ? "err" : "")">@hint</p>
    }

    <label>
        E-Mail-Adresse <small>bzw. Benutzername</small>
        <InputText @bind-Value="acc.Username" @bind-Value:after="UsernameChanged" autocomplete="off" placeholder="name@gmx.de" />
    </label>
    @if (discovering)
    {
        <p class="muted">Suche Einstellungen für @Domain …</p>
    }
    else if (discoverInfo is not null)
    {
        <p class="muted">@discoverInfo</p>
    }
    <label>
        Passwort @if (Id is not null){<small>leer lassen = unverändert</small>}
        <InputText type="password" @bind-Value="password" autocomplete="new-password" />
    </label>

    @if (Preset is { Host: { } presetHost })
    {
        <p class="muted">Server: @presetHost:@Preset.Port · <button type="button" class="link" @onclick="() => provider = Other">ändern</button></p>
    }
    else if (provider == Other || Id is not null)
    {
        <label>IMAP-Server <InputText @bind-Value="acc.Host" placeholder="z. B. imap.example.org" /></label>
        <label>Port <small>143 = STARTTLS, sonst SSL/TLS (meist 993)</small> <InputNumber @bind-Value="acc.Port" /></label>
    }

    <details open="@advanced">
        <summary>Erweitert</summary>
        <div class="form">
            <label>Anzeigename <small>leer = E-Mail-Adresse</small> <InputText @bind-Value="acc.Name" /></label>
            <label>Zu prüfender Ordner <InputText @bind-Value="acc.Folder" /></label>
            <label>
                Spam-Ordner @if (folders is null){<small>Ordnerliste über „Verbindung testen“ laden</small>}
                <select @bind="acc.SpamFolder">
                    <option value="">automatisch (Spam-Ordner des Anbieters)</option>
                    @if (acc.SpamFolder != "" && folders?.Any(f => f.FullName == acc.SpamFolder) != true)
                    {
                        <option value="@acc.SpamFolder">@acc.SpamFolder</option>
                    }
                    @foreach (var f in folders ?? [])
                    {
                        <option value="@f.FullName" disabled="@(!f.Selectable)">@(new string('\u00A0', f.Depth * 4) + f.Name)</option>
                    }
                </select>
            </label>
            <label>Spam ab Score <small>rspamd-Standard 6, niedriger = strenger</small> <InputNumber @bind-Value="acc.Threshold" step="0.5" /></label>
            <label class="check"><InputCheckbox @bind-Value="acc.Enabled" /> aktiv</label>
        </div>
    </details>

    @if (error is not null)
    {
        <p class="err">@error</p>
    }
    <div class="row">
        <button type="submit" class="primary">Speichern</button>
        <button type="button" @onclick="Test" disabled="@testing">@(testing ? "Teste …" : "Verbindung testen")</button>
        @if (Id is not null)
        {
            <button type="button" class="danger" @onclick="Delete">@(confirmDelete ? "Wirklich löschen?" : "Löschen")</button>
        }
        <a href="">Abbrechen</a>
    </div>
</EditForm>

@if (testResult is not null)
{
    <p class="@(folders is null ? "err" : "ok")">@testResult</p>
}
@code {
    const string Other = "-";
    [Parameter] public long? Id { get; set; }
    Account acc = new() { SpamFolder = "" };
    string provider = "", password = "";
    string? error, testResult;
    List<Scanner.FolderNode>? folders;
    bool testing, confirmDelete, discovering, advanced;
    string? discoverInfo;

    string Domain => acc.Username.Split('@').LastOrDefault() ?? "";

    Provider? Preset => Providers.ByName(provider);

    protected override void OnParametersSet()
    {
        if (Id is not long id) return;
        if (Db.Account(id) is not { } found)
        {
            Nav.NavigateTo("");
            return;
        }
        acc = found;
        advanced = true;
        provider = Providers.ByHost(acc.Host)?.Name ?? Other;
    }

    // Beim Bearbeiten Ordnerliste gleich laden, damit das Dropdown gefüllt ist
    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender && Id is not null ? Reload() : Task.CompletedTask;

    async Task Reload()
    {
        await Test();
        StateHasChanged();
    }

    void ApplyProvider()
    {
        if (Preset is { Host: { } host } p) (acc.Host, acc.Port) = (host, p.Port);
    }

    // Anbieter an der E-Mail-Adresse erkennen, solange keiner gewählt ist: erst bekannte Liste, dann Autodiscovery
    async Task UsernameChanged()
    {
        if (provider != "" || !acc.Username.Contains('@')) return;
        if (Providers.ByAddress(acc.Username) is { } known)
        {
            provider = known.Name;
            ApplyProvider();
            return;
        }
        discovering = true;
        StateHasChanged();
        var found = await Autodiscover.Find(acc.Username);
        discovering = false;
        if (provider != "") return;  // inzwischen von Hand gewählt
        if (found is null)
        {
            provider = Other;
            discoverInfo = $"Keine Einstellungen für {Domain} gefunden – bitte Anbieter wählen oder Server eintragen.";
            return;
        }
        (acc.Host, acc.Port) = (found.Host, found.Port);
        provider = Providers.ByHost(found.Host)?.Name ?? Other;
        var user = found.Username != acc.Username ? $", Benutzer „{found.Username}“" : "";
        acc.Username = found.Username;
        discoverInfo = $"Gefunden: {found.Host}:{found.Port}{user} (Quelle: {found.Source})";
    }

    void Save()
    {
        acc.Username = acc.Username.Trim();
        acc.Host = acc.Host.Trim();
        acc.Name = acc.Name.Trim() is "" ? acc.Username : acc.Name.Trim();
        acc.Folder = acc.Folder.Trim() is "" ? "INBOX" : acc.Folder.Trim();
        acc.SpamFolder = acc.SpamFolder.Trim();
        if (password != "") acc.Password = password;
        error = acc switch
        {
            _ when Preset is { Host: null } => "Dieser Anbieter wird nicht unterstützt.",
            { Host: "" } => "Bitte Anbieter wählen oder IMAP-Server eintragen.",
            { Username: "" } => "E-Mail-Adresse bzw. Benutzer fehlt.",
            { Password: "" } => "Passwort fehlt.",
            { Port: < 1 or > 65535 } => "Ungültiger Port.",
            _ => null,
        };
        if (error is not null) return;

        if (Id is null)
            acc.Id = Db.Query<long>("""
                insert into accounts(name,host,port,username,password,folder,spamfolder,threshold,enabled)
                values(@Name,@Host,@Port,@Username,@Password,@Folder,@SpamFolder,@Threshold,@Enabled) returning id
                """, acc).Single();
        else
            // anderes Postfach/Ordner: wieder bei den letzten Mails anfangen
            Db.Exec("""
                update accounts set uidvalidity = case when host=@Host and username=@Username and folder=@Folder then uidvalidity end,
                  name=@Name, host=@Host, port=@Port, username=@Username, password=@Password, folder=@Folder,
                  spamfolder=@SpamFolder, threshold=@Threshold, enabled=@Enabled
                where id=@Id
                """, acc);
        Scanner.Restart(acc.Id);
        Nav.NavigateTo("");
    }

    async Task Test()
    {
        (testing, testResult, folders) = (true, null, null);
        var probe = new Account
        {
            Host = acc.Host.Trim(), Port = acc.Port, Username = acc.Username.Trim(),
            Password = password != "" ? password : acc.Password, SpamFolder = acc.SpamFolder.Trim(),
        };
        try
        {
            (folders, var spam) = await Scanner.Folders(probe);
            testResult = $"Verbindung OK. Spam wird verschoben nach: {spam}";
            advanced = true;  // Spam-Ordner-Auswahl zeigen
        }
        catch (Exception e)
        {
            testResult = "Fehler: " + e.Message;
        }
        testing = false;
    }

    void Delete()
    {
        if (!confirmDelete)
        {
            confirmDelete = true;
            return;
        }
        Db.Exec("delete from accounts where id=@Id; delete from known where accountid=@Id", new { Id });
        Scanner.Restart(Id!.Value);
        Nav.NavigateTo("");
    }
}
