@page "/settings"
@attribute [Authorize(Roles = Users.Admin)]
@inject Scanner Scanner

<PageTitle>Einstellungen – SpamSharp</PageTitle>

<h2>Einstellungen</h2>
<div class="form">
    @foreach (var (key, def) in Settings.All)
    {
        <label>@def.Label <input @bind="values[key]" inputmode="@(def.Numeric ? "numeric" : "text")" /></label>
    }
    @if (message is not null)
    {
        <p class="@(saved ? "ok" : "err")">@message</p>
    }
    <div class="row"><button class="primary" @onclick="Save">Speichern</button></div>
</div>

<h2>Benutzer</h2>
<p class="muted">
    Jeder Benutzer sieht nur seine eigenen Postfächer. Gelernt wird gemeinsam, Regeln und Einstellungen ändert nur „admin“
    (Passwort über ADMIN_PASSWORD).
</p>
@if (users.Count > 0)
{
    <div class="scroll users">
        <table>
            <tbody>
                @foreach (var u in users)
                {
                    <tr>
                        <td>@u</td>
                        <td class="actions">
                            <button class="danger" @onclick="() => DeleteUser(u)">@(confirmDelete == u ? "Wirklich löschen (mit Postfächern)?" : "Löschen")</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<div class="form">
    <label>Benutzername <input @bind="newUser" autocomplete="off" autocapitalize="none" /></label>
    <label>Passwort <small>mind. 8 Zeichen; bei vorhandenem Benutzer wird das Passwort ersetzt</small>
        <input type="password" @bind="newPassword" autocomplete="new-password" /></label>
    @if (userMessage is not null)
    {
        <p class="@(userOk ? "ok" : "err")">@userMessage</p>
    }
    <div class="row"><button class="primary" @onclick="SaveUser">Benutzer speichern</button></div>
</div>

@if (users.Count > 0)
{
    <h3>Postfächer zuweisen</h3>
    <p class="muted">Ein Postfach samt seinen Mails sieht nur sein Besitzer.</p>
    <div class="scroll users">
        <table>
            <tbody>
                @foreach (var a in accounts)
                {
                    <tr>
                        <td>@a.Name<br /><small class="muted">@a.Username</small></td>
                        <td>
                            <select value="@a.Owner" @onchange="e => Assign(a, (string)e.Value!)" aria-label="Besitzer von @a.Name">
                                @foreach (var u in users.Prepend(Users.Admin))
                                {
                                    <option value="@u">@u</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    readonly Dictionary<string, string> values = Settings.All.Keys.ToDictionary(k => k, Settings.Get);
    string? message;
    bool saved;
    List<string> users = Users.All();
    List<Account> accounts = Db.Accounts();
    string newUser = "", newPassword = "";
    string? userMessage, confirmDelete;
    bool userOk;

    void SaveUser()
    {
        var name = newUser.Trim();
        (userOk, userMessage) = name switch
        {
            "" => (false, "Bitte einen Benutzernamen eingeben."),
            _ when name.Equals(Users.Admin, StringComparison.OrdinalIgnoreCase) => (false, "„admin“ ist reserviert."),
            _ when newPassword.Length < 8 => (false, "Das Passwort braucht mindestens 8 Zeichen."),
            _ => (true, $"Benutzer „{name}“ gespeichert."),
        };
        if (!userOk) return;
        Users.Save(name, newPassword);
        (newUser, newPassword, users) = ("", "", Users.All());
    }

    void Assign(Account a, string owner)
    {
        Db.Exec("update accounts set owner=@owner where id=@Id", new { owner, a.Id });
        a.Owner = owner;
        (userOk, userMessage) = (true, $"„{a.Name}“ gehört jetzt {owner}.");
    }

    void DeleteUser(string name)
    {
        if (confirmDelete != name)
        {
            confirmDelete = name;
            return;
        }
        foreach (var id in Users.Delete(name)) Scanner.Restart(id);
        (confirmDelete, users, accounts, userOk, userMessage) = (null, Users.All(), Db.Accounts(), true, $"Benutzer „{name}“ gelöscht.");
    }

    void Save()
    {
        var bad = Settings.All.Where(s => s.Value.Numeric && !(int.TryParse(values[s.Key], out var n) && n > 0))
                              .Select(s => s.Value.Label).FirstOrDefault();
        var empty = values.Any(v => v.Value.Trim() == "");
        (saved, message) = (bad, empty) switch
        {
            ({ } label, _) => (false, $"Bitte eine positive Zahl eintragen: {label}"),
            (_, true) => (false, "Bitte alle Felder ausfüllen."),
            _ => (true, "Gespeichert."),
        };
        if (!saved) return;
        foreach (var (k, v) in values) Settings.Set(k, v.Trim());
        Scanner.RestartAll();
    }
}
