@page "/settings"
@attribute [Authorize(Roles = Users.Admin)]
@inject Scanner Scanner

<PageTitle>Einstellungen – SpamSharp</PageTitle>

<h2>Einstellungen</h2>
<div class="form">
    @foreach (var (key, def) in Settings.All)
    {
        <label>@def.Label <input @bind="values[key]" inputmode="@(def.Numeric ? "numeric" : "text")" /></label>
    }
    @if (message is not null)
    {
        <p class="@(saved ? "ok" : "err")">@message</p>
    }
    <div class="row"><button class="primary" @onclick="Save">Speichern</button></div>
</div>

<h2>Benutzer</h2>
<p class="muted">
    Jeder Benutzer sieht nur seine eigenen Postfächer. Gelernt wird gemeinsam, Regeln und Einstellungen ändert nur „admin“
    (Passwort über ADMIN_PASSWORD).
</p>
@if (users.Count > 0)
{
    <div class="scroll users">
        <table>
            <tbody>
                @foreach (var u in users)
                {
                    <tr>
                        <td>
                            @if (renaming == u)
                            {
                                <input @bind="renameTo" type="email" autocapitalize="none" aria-label="Neuer Name für @u" />
                            }
                            else
                            {
                                @u
                            }
                        </td>
                        <td class="actions">
                            <button @onclick="() => RenameUser(u)">@(renaming == u ? "Übernehmen" : "Umbenennen")</button>
                            <button class="danger" @onclick="() => DeleteUser(u)">@(confirmDelete == u ? "Wirklich löschen (mit Postfächern)?" : "Löschen")</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<div class="form">
    <label>E-Mail-Adresse <small>dorthin geht „Passwort vergessen“</small>
        <input type="email" @bind="newUser" autocomplete="off" autocapitalize="none" /></label>
    <label>Passwort <small>mind. 8 Zeichen; bei vorhandenem Benutzer wird das Passwort ersetzt@(Mailer.Enabled ? "; leer = Einladung per Mail, Passwort legt der Benutzer selbst fest" : "")</small>
        <input type="password" @bind="newPassword" autocomplete="new-password" /></label>
    @if (userMessage is not null)
    {
        <p class="@(userOk ? "ok" : "err")">@userMessage</p>
    }
    <div class="row"><button class="primary" @onclick="SaveUser">Benutzer speichern</button></div>
</div>

@if (users.Count > 0)
{
    <h3>Postfächer zuweisen</h3>
    <p class="muted">Ein Postfach samt seinen Mails sieht nur sein Besitzer.</p>
    <div class="scroll users">
        <table>
            <tbody>
                @foreach (var a in accounts)
                {
                    <tr>
                        <td>@a.Name<br /><small class="muted">@a.Username</small></td>
                        <td>
                            <select value="@a.Owner" @onchange="e => Assign(a, (string)e.Value!)" aria-label="Besitzer von @a.Name">
                                @foreach (var u in users.Prepend(Users.Admin))
                                {
                                    <option value="@u">@u</option>
                                }
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    readonly Dictionary<string, string> values = Settings.All.Keys.ToDictionary(k => k, Settings.Get);
    string? message;
    bool saved;
    List<string> users = Users.All();
    List<Account> accounts = Db.Accounts();
    string newUser = "", newPassword = "";
    string? userMessage, confirmDelete, renaming;
    string renameTo = "";
    bool userOk;

    async Task SaveUser()
    {
        var name = newUser.Trim();
        var invite = newPassword == "" && Mailer.Enabled;
        (userOk, userMessage) = name switch
        {
            "" => (false, "Bitte eine E-Mail-Adresse eingeben."),
            _ when !Users.IsEmail(name) && !Users.Exists(name) => (false, "Bitte eine gültige E-Mail-Adresse eingeben."),
            _ when invite && !Users.IsEmail(name) => (false, "Einladung geht nur an eine E-Mail-Adresse, bitte erst umbenennen."),
            _ when !invite && newPassword.Length < 8 => (false, "Das Passwort braucht mindestens 8 Zeichen."),
            _ => (true, $"Benutzer „{name}“ gespeichert."),
        };
        if (!userOk) return;
        if (!invite) Users.Save(name, newPassword);
        else
        {
            // vorhandener Benutzer behält sein Passwort, bis er den Link benutzt (= Einladung erneut senden)
            if (!Users.Exists(name)) Users.Save(name, Convert.ToBase64String(System.Security.Cryptography.RandomNumberGenerator.GetBytes(24)));
            try
            {
                await Mailer.Invite(name);
                userMessage = $"Einladung an „{name}“ verschickt.";
            }
            catch (Exception e)
            {
                (userOk, userMessage) = (false, $"Benutzer angelegt, aber die Einladung konnte nicht verschickt werden: {e.Message}");
            }
        }
        (newUser, newPassword, users) = ("", "", Users.All());
    }

    void RenameUser(string name)
    {
        if (renaming != name)
        {
            (renaming, renameTo) = (name, Users.IsEmail(name) ? name : "");
            return;
        }
        var to = renameTo.Trim();
        (userOk, userMessage) = to switch
        {
            _ when to == name => (true, null),
            _ when !Users.IsEmail(to) => (false, "Bitte eine gültige E-Mail-Adresse eingeben."),
            _ when !to.Equals(name, StringComparison.OrdinalIgnoreCase) && Users.Exists(to) => (false, $"„{to}“ gibt es schon."),
            _ => (true, $"„{name}“ heißt jetzt „{to}“."),
        };
        if (!userOk) return;
        if (to != name) Users.Rename(name, to);
        (renaming, users, accounts) = (null, Users.All(), Db.Accounts());
    }

    void Assign(Account a, string owner)
    {
        Db.Exec("update accounts set owner=@owner where id=@Id", new { owner, a.Id });
        a.Owner = owner;
        (userOk, userMessage) = (true, $"„{a.Name}“ gehört jetzt {owner}.");
    }

    void DeleteUser(string name)
    {
        if (confirmDelete != name)
        {
            confirmDelete = name;
            return;
        }
        foreach (var id in Users.Delete(name)) Scanner.Restart(id);
        (confirmDelete, users, accounts, userOk, userMessage) = (null, Users.All(), Db.Accounts(), true, $"Benutzer „{name}“ gelöscht.");
    }

    void Save()
    {
        var bad = Settings.All.Where(s => s.Value.Numeric && !(int.TryParse(values[s.Key], out var n) && n > 0))
                              .Select(s => s.Value.Label).FirstOrDefault();
        var empty = values.Any(v => v.Value.Trim() == "");
        (saved, message) = (bad, empty) switch
        {
            ({ } label, _) => (false, $"Bitte eine positive Zahl eintragen: {label}"),
            (_, true) => (false, "Bitte alle Felder ausfüllen."),
            _ => (true, "Gespeichert."),
        };
        if (!saved) return;
        foreach (var (k, v) in values) Settings.Set(k, v.Trim());
        Scanner.RestartAll();
    }
}
